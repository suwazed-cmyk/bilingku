Options -Indexes
<IfModule mod_authz_core.c>
# berkas data, catatan, dan arsip tidak boleh diunduh langsung dari internet
<FilesMatch "\.(tmp|json|log|md|txt|zip|rsc|bak|sql|gz|tar)$">
Require all denied
</FilesMatch>
</IfModule>

# gambar (logo, favicon) boleh disimpan browser 30 hari; CSS/JS dilayani asset.php dengan cache 1 tahun
<IfModule mod_headers.c>
<FilesMatch "\.(svg|png|jpe?g|gif|webp|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
